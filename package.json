{
  "name": "vscode-ulog-viewer",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.0.7",
  "publisher": "anilkir",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/anilkir/vscode-ulog-viewer.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "media/ulog_viewer.png",
  "categories": [
    "Visualization",
    "Data Science"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "customEditors": [
      {
        "viewType": "ulogViewer.ulog",
        "displayName": "ULog Viewer",
        "selector": [
          {
            "filenamePattern": "*.ulg"
          },
          {
            "filenamePattern": "*.ulog"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ulogViewer",
          "title": "ULog Viewer",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "ulogViewer": [
        {
          "id": "ulogViewer.filesView",
          "name": "%view.filesView.name%",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "ulogViewer.openFile",
        "title": "%command.openFile.title%",
        "icon": "$(folder-opened)",
        "category": "ULog Viewer"
      },
      {
        "command": "ulogViewer.openFolder",
        "title": "%command.openFolder.title%",
        "icon": "$(folder)",
        "category": "ULog Viewer"
      },
      {
        "command": "ulogViewer.refreshFiles",
        "title": "%command.refreshFiles.title%",
        "icon": "$(refresh)",
        "category": "ULog Viewer"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ulogViewer.refreshFiles",
          "when": "view == ulogViewer.filesView",
          "group": "navigation@1"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@foxglove/ulog": "^2.3.2",
    "uplot": "^1.6.32"
  }
}
